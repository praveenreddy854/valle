# Valle example environment.
#
# Copy to .env in the repo root on the brain machine (Mac):
#   cp .env.example .env
#
# The brain API (`make brain-api`) and the agent runner load .env
# automatically. The Pi app (`make app`) does NOT read .env: set Pi settings
# with `export` in the shell, or prefix the command, e.g.
#   VALLE_CAMERA_IDLE_SECONDS=60 make app
#
# Uncommented lines are the recommended settings to fill in. Commented lines
# show each setting's default; uncomment one only to change it.

# =============================================================================
# Brain (Mac): where the Pi is
# =============================================================================
# Use the Pi's IP if rpi.local doesn't resolve (find it with `hostname -I` on the Pi).
VALLE_PI_BASE_URL=http://rpi.local:8080
VALLE_PI_WS_URL=ws://rpi.local:8080/brain/find
VALLE_CAMERA_URL=http://rpi.local:8081/stream.mjpg
VALLE_PORTAL_CAMERA_URL=http://rpi.local:8081/stream.mjpg

# Listen on all interfaces so other devices on your network can reach the brain.
VALLE_BRAIN_API_HOST=0.0.0.0
# VALLE_BRAIN_API_PORT=8090

# =============================================================================
# LLM provider: agent missions, vision checks, and map-guided seek
# =============================================================================
# "azure" or "anthropic".
VALLE_LLM_PROVIDER=anthropic

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# VALLE_ANTHROPIC_MODEL=claude-opus-5-5
# Optional separate model for vision checks and the seek planner.
# VALLE_VISION_MODEL=

# --- Azure OpenAI (when VALLE_LLM_PROVIDER=azure) ---
# AZURE_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# Either the resource name or the full endpoint:
# AZURE_RESOURCE_NAME=
# AZURE_ENDPOINT=
# AZURE_API_VERSION=2024-06-01
# Optional separate deployment for vision checks; must accept images.
# VALLE_VISION_DEPLOYMENT=

# =============================================================================
# Driving speeds used by seek and autopilot (percent)
# =============================================================================
# Many gear motors stall below ~60%; raise these if the car hums but doesn't move.
VALLE_SPEED_FORWARD=80
VALLE_SPEED_TURN=80
VALLE_SPEED_BACKWARD=70
# Pulse length per tick, in seconds.
# VALLE_PULSE_FORWARD=0.30
# VALLE_PULSE_TURN=0.20
# VALLE_PULSE_BACKWARD=0.30

# =============================================================================
# Seek
# =============================================================================
# "map" (LLM room map; needs an LLM provider) or "reflex" (wander, no LLM).
VALLE_SEEK_MODE=map
# Pivot pulse that turns ~90 degrees. Tune until four pivots make one full turn.
VALLE_SEEK_QUARTER_TURN_SECONDS=0.6
# VALLE_SEEK_LEG_SECONDS=6
# VALLE_SEEK_PLANNER_EFFORT=low
# VALLE_SEEK_DEFAULT_MAX_SECONDS=60
# VALLE_SEEK_FOUND_SCORE=0.20
# VALLE_SEEK_PULSE_SECONDS=4.0
# VALLE_ROOM_MAP_FILE=logs/room-map.json

# =============================================================================
# Camera, brain side
# =============================================================================
# The Pi camera turns on only when needed; wait this long for the first frame.
# VALLE_CAMERA_WARMUP_SECONDS=5
# Length of one portal camera view before it turns off.
# VALLE_PORTAL_CAMERA_SECONDS=60

# =============================================================================
# Perception models and reflex tuning
# =============================================================================
# VALLE_DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
# VALLE_DEPTH_DEVICE=auto
# VALLE_DETECTOR_MODEL=google/owlv2-base-patch16-ensemble
# VALLE_DETECTOR_DEVICE=auto
# VALLE_SCORE_THRESHOLD=0.10
# VALLE_MAX_RESULTS=5
# VALLE_BRAIN_TICK_HZ=4.0
# VALLE_BRAIN_GRACE_SECONDS=2.0
# VALLE_BRAIN_REQUEST_TIMEOUT=3.0
# VALLE_BRAIN_SESSION_MAX_SECONDS=
# VALLE_BRAIN_SESSION_IDLE_SECONDS=
# VALLE_BLOCKED_THRESHOLD=0.55
# VALLE_HYSTERESIS_MARGIN=0.05
# VALLE_LEFT_STRIP_END=0.33
# VALLE_RIGHT_STRIP_START=0.67
# VALLE_TOP_CROP=0.15
# VALLE_BOTTOM_CROP=0.10
# VALLE_RECONNECT_SECONDS=3.0

# =============================================================================
# Agent missions, scheduler, and notifications
# =============================================================================
# Push mission results to an ntfy topic or similar webhook. Unset = no notifications.
# VALLE_NOTIFY_URL=https://ntfy.sh/your-topic
# VALLE_AGENT_MAX_STEPS=20
# VALLE_AGENT_MISSION_JSON=
# VALLE_SCHEDULER_POLL_SECONDS=20
# VALLE_MISSIONS_FILE=missions.json
# VALLE_HOUSEHOLD_FILE=household.json
# VALLE_RUNS_FILE=logs/agent-runs.jsonl
# VALLE_LESSONS_FILE=logs/agent-lessons.jsonl
# VALLE_EVIDENCE_DIR=evidence
# Keep CrewAI's own cloud tracing off; Valle's OpenTelemetry stays on.
CREWAI_TRACING_ENABLED=false

# =============================================================================
# Logs and telemetry (both machines)
# =============================================================================
# VALLE_LOG_DIR=logs
# VALLE_LOG_LEVEL=INFO
# VALLE_LOG_CONSOLE=true
# VALLE_LOG_MAX_BYTES=10000000
# VALLE_LOG_BACKUP_COUNT=5
# VALLE_LOG_SUPPRESS_PORTAL_POLLING=true
# VALLE_VERBOSE_SDK_LOGS=false
# VALLE_OTEL_ENABLED=true
# VALLE_OTEL_METRICS_INTERVAL_MS=15000
# VALLE_OTEL_TRACES_FILE=logs/<service>.traces.jsonl
# VALLE_OTEL_METRICS_FILE=logs/<service>.metrics.jsonl
# Also send traces and metrics to an OTLP/HTTP collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# =============================================================================
# Pi (`make app`): set with `export` on the Pi; .env is not read there
# =============================================================================
# VALLE_HOST=0.0.0.0
# VALLE_PORT=8080
# VALLE_DRIVER=auto
# VALLE_DEFAULT_SPEED_PERCENT=60
# VALLE_DEFAULT_DURATION_SECONDS=5
# VALLE_MAX_DURATION_SECONDS=5
# VALLE_TURN_DURATION_SECONDS=0.25
# VALLE_AUTOPILOT_MAX_SECONDS=1800
# VALLE_AUTOPILOT_IDLE_SECONDS=20
# VALLE_FIND_TIMEOUT_SECONDS=10
# VALLE_SEEK_MAX_SECONDS=60
# VALLE_SEEK_TIMEOUT_BUFFER_SECONDS=10
# Motor pins (BCM numbering)
# VALLE_LEFT_FORWARD_PIN=5
# VALLE_LEFT_BACKWARD_PIN=6
# VALLE_LEFT_ENABLE_PIN=12
# VALLE_RIGHT_FORWARD_PIN=20
# VALLE_RIGHT_BACKWARD_PIN=21
# VALLE_RIGHT_ENABLE_PIN=13
# Camera: records only while driving, streaming, or for this long after.
# VALLE_CAMERA_HOST=0.0.0.0
# VALLE_CAMERA_PORT=8081
# VALLE_CAMERA_WIDTH=640
# VALLE_CAMERA_HEIGHT=480
# VALLE_CAMERA_FPS=10
# VALLE_CAMERA_IDLE_SECONDS=60
